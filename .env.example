# ─────────────────────────────────────────────────────────────
# ForgeFit environment configuration
# Copy to `.env` and fill in. NONE of these are required to run the
# app in local/offline mode — the app ships with mock service
# implementations so every flow is testable without any backend.
# ─────────────────────────────────────────────────────────────

# Supabase (auth + cloud sync). Leave blank to run fully offline (local storage only).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Secure AI backend endpoint. This is YOUR server (see /server), never a raw
# model provider key. If blank, the app uses the on-device mock AI service.
EXPO_PUBLIC_AI_API_URL=

# RevenueCat public SDK keys (subscriptions). Blank => mock subscription store.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# AdMob unit ids (free tier ads). Blank => ads render as inert placeholders.
EXPO_PUBLIC_ADMOB_IOS_BANNER=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=

# Product analytics (privacy-conscious). Blank => events logged to console in dev only.
EXPO_PUBLIC_ANALYTICS_KEY=

# ── SERVER-SIDE ONLY (never bundled into the app) ──
# These live in your AI backend deployment, not the mobile build.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
