# ─────────────────────────────────────────────────────────────
# ForgeFit environment configuration
#
# Copy to `.env` and fill in what you want switched on. NONE of these
# are required to run the app: every integration degrades to a mock or
# to an honest "not connected" state when its variable is blank, so the
# whole app is walkable offline with no account anywhere.
#
# Anything prefixed EXPO_PUBLIC_ is compiled into the app bundle and is
# readable by anyone who downloads it. Only publishable identifiers go
# here. Every real secret lives in the two server sections at the
# bottom, and the app talks to those servers rather than to the vendor.
# ─────────────────────────────────────────────────────────────

# ── Supabase: accounts, cloud sync, account deletion ──
# Project Settings → API. The anon key is meant to be public; Row Level
# Security is what protects the data, not the key.
# Blank => the app runs entirely on local storage, no account.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Your AI backend ──
# The base URL of a server YOU run that holds the model provider key and
# forwards requests. Never a raw Anthropic/OpenAI key — one shipped in an
# app bundle is a stranger's bill.
# Blank => the on-device coach, which is rule-based and says so.
EXPO_PUBLIC_AI_API_URL=

# ── Strava ──
# The client ID is public (it appears in the authorize URL anyway).
# The exchange URL is your own endpoint — /api/strava/exchange in this
# repo — which is the only place the client secret exists.
# Blank => the Integrations screen says Strava is not configured.
EXPO_PUBLIC_STRAVA_CLIENT_ID=
EXPO_PUBLIC_STRAVA_EXCHANGE_URL=

# ── RevenueCat: subscriptions ──
# The *public* SDK keys, one per platform. Blank => the paywall runs in
# mock mode and nothing is ever charged.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ── AdMob: banner unit ids for the free tier ──
# Unit ids, not your account id. Blank => ad slots render as inert
# placeholders. Ads never appear during an active workout, and no health
# data is ever used to target them.
EXPO_PUBLIC_ADMOB_IOS_BANNER=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=

# ── Open Wearables (optional): Garmin, WHOOP, Oura, Polar, Suunto, Fitbit ──
# An open-source service YOU run (github.com/the-momentum/open-wearables, MIT)
# that puts a dozen device makers behind one API. This is your OWN proxy
# endpoint, not theirs — their summary routes require the master API key,
# which grants every user's data and must never be in the app.
# Blank => the screen explains the arrangement and does nothing else.
EXPO_PUBLIC_OPEN_WEARABLES_SUMMARY_URL=

# ── Gym search (Iron Map) ──
# The base URL of your own proxy for a points-of-interest source. The app
# carries no maps key of its own, and coarse coordinates leave the device
# only after the user opts in.
# Blank => the map falls back to its bundled gym list.
EXPO_PUBLIC_GYM_API_URL=

# ── Food barcode lookup (Open Food Facts) ──
# No key and no account — it is a public database. Set to "off" to disable
# lookups entirely; the app still works, it just asks you to type a label the
# first time it meets a barcode. The URL only needs setting for a mirror.
# USDA FoodData Central — laboratory reference data for whole foods.
# The key is free (api.data.gov) and rate limited PER KEY rather than per
# user, so it lives on your server and the app calls the proxy.
EXPO_PUBLIC_USDA_FOOD_URL=
EXPO_PUBLIC_FOOD_LOOKUP=
EXPO_PUBLIC_FOOD_LOOKUP_URL=

# ── Product analytics ──
# Blank => events are logged to the console in development and dropped in
# production. Health values are never sent as event properties.
EXPO_PUBLIC_ANALYTICS_KEY=


# ═════════════════════════════════════════════════════════════
# SERVER-SIDE ONLY — set these on the host, never in the app build.
# Nothing below is prefixed EXPO_PUBLIC_, so nothing below is bundled.
# ═════════════════════════════════════════════════════════════

# ── /api/strava/* (this repo's Vercel functions) ──
# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Comma-separated origins allowed to call the exchange endpoint.
# Blank => same-origin only.
ALLOWED_ORIGINS=

# ── supabase/functions/delete-account ──
# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY into deployed functions automatically; set
# them by hand only when running the function locally.
# The service-role key bypasses Row Level Security. It must never reach
# the app, a browser, or this file's non-server half.

# ── /api/wearables/summary (this repo's Vercel function) ──
# The master API key from your Open Wearables developer portal. Their summary
# endpoints accept nothing else: an SDK-scoped token is explicitly refused
# there (get_current_developer_optional returns None for scope "sdk"), so
# there is no mobile-safe credential and the call has to be proxied.
OPEN_WEARABLES_URL=
OPEN_WEARABLES_API_KEY=

# Server only. From api.data.gov. Never put this in the app bundle.
USDA_FDC_API_KEY=

# ── Your AI backend (wherever you host it) ──
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
